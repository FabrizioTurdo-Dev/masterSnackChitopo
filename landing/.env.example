# URL del catálogo mayorista.
# En producción, landing y catálogo viven bajo el mismo dominio:
#   VITE_CATALOGO_URL=/catalogo/
# En desarrollo apunta al dev server del catálogo.
VITE_CATALOGO_URL=http://localhost:5173

# Supabase: las mismas credenciales públicas que el catálogo. La landing lee
# de ahí el WhatsApp y el pedido mínimo que se editan en el panel. Sin
# definir, usa los valores de src/data/store.js.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
